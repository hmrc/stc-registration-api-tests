meta {
  name: Individual 201
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}{{basePath}}/subscription
  body: json
  auth: inherit
}

headers {
  correlation-id: abcd
}

body:json {
  {
    "safeId": "safe1235",
    "contactName": "John Doe",
    "addressLine1": "123 Main Street",
    "addressLine2": "Apt 4B",
    "addressLine3": null,
    "postcode": "SW1A 1AA",
    "countryCode": "UK",
    "telephoneNumber": "+44 20 7946 0958",
    "mobileNumber": "+44 7700 900123",
    "email": "john.doe@example.com"
  }
}

tests {
  test("Status code is 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  
  test("Store request and response values", function () {
  
    // Response body
    const responseJson = res.getBody();
  
    // Request body
    const requestBody = req.getBody();
  
    // Store response values
    bru.setEnvVar("subscriptionId", responseJson.subscriptionId);
  
    // Store request values
    bru.setEnvVar("safeId", requestBody.safeId);
    bru.setEnvVar("contactName", requestBody.contactName);
    bru.setEnvVar("addressLine1", requestBody.addressLine1);
    bru.setEnvVar("addressLine2", requestBody.addressLine2);
    bru.setEnvVar("addressLine3", requestBody.addressLine3);
    bru.setEnvVar("postcode", requestBody.postcode);
    bru.setEnvVar("countryCode", requestBody.countryCode);
    bru.setEnvVar("telephoneNumber", requestBody.telephoneNumber);
    bru.setEnvVar("mobileNumber", requestBody.mobileNumber);
    bru.setEnvVar("email", requestBody.email);
  
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
